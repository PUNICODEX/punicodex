{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessContinue": "off",
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConsole": { "level": "off", "options": { "allow": ["log"] } },
        "noControlCharactersInRegex": "off",
        "noRedundantUseStrict": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noUnusedTemplateLiteral": "off",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["middleware.js"],
      "javascript": {
        "globals": ["Request", "Response", "fetch", "URL"]
      }
    },
    {
      "includes": ["sdk/js/src/**/*.js", "test/sdk-js.test.js"],
      "javascript": {
        "globals": ["fetch", "URL"]
      }
    },
    {
      "includes": ["extension-v2/**/*.js", "test/extension-v2.test.js"],
      "javascript": {
        "globals": [
          "chrome",
          "document",
          "window",
          "fetch",
          "location",
          "sessionStorage",
          "localStorage",
          "MutationObserver",
          "Node",
          "navigator"
        ]
      }
    },
    {
      "includes": ["mobile/js/shield.js"],
      "javascript": {
        "globals": [
          "document",
          "window",
          "localStorage",
          "navigator",
          "PUNYCODEX_MOBILE_CLASSIFIER"
        ]
      }
    }
  ],
  "files": {
    "maxSize": 2097152,
    "includes": [
      "api/**/*.js",
      "type/js/engine.js",
      "type/js/test-engine.js",
      "type/js/validate.js",
      "platform/**/*.js",
      "test/**/*.js",
      "scripts/validate-accuracy.js",
      "scripts/validate-seo.js",
      "scripts/generate-temples.js",
      "scripts/create-flagship.js",
      "scripts/import-utils.js",
      "scripts/import-runner.js",
      "scripts/import-orchestrator.js",
      "scripts/apply-suggestions.js",
      "scripts/update-data-version.js",
      "data/authoritative/importers/*.js",
      "scripts/lore-stubs.js",
      "scripts/regenerate-stub-flagships.js",
      "scripts/migrate-lore-to-scholars.js",
      "sdk/js/**/*.js",
      "extension-v2/**/*.js",
      "mobile/js/shield.js",
      "test/sdk-js.test.js",
      "test/extension-v2.test.js",
      "test/mobile-share-extension.test.js",
      "package.json",
      "biome.json"
    ]
  }
}
