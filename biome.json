{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessContinue": "off",
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConsole": { "level": "off", "options": { "allow": ["log"] } },
        "noControlCharactersInRegex": "off",
        "noRedundantUseStrict": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noUnusedTemplateLiteral": "off",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["middleware.js"],
      "javascript": {
        "globals": ["Request", "Response", "fetch", "URL"]
      }
    }
  ],
  "files": {
    "includes": [
      "api/**/*.js",
      "type/js/engine.js",
      "type/js/test-engine.js",
      "type/js/validate.js",
      "platform/**/*.js",
      "test/**/*.js",
      "scripts/validate-accuracy.js",
      "scripts/validate-seo.js",
      "scripts/generate-temples.js",
      "scripts/create-flagship.js",
      "package.json",
      "biome.json"
    ]
  }
}
