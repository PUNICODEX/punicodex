# PUNICODEX environment template
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to Git.

# Admin & security
ADMIN_PASSWORD=change-me-in-production
CRON_SECRET=generate-a-long-random-secret

# Platform URL
PLATFORM_URL=http://localhost:3456

# Database
DATABASE_URL=
REDIS_URL=

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
RESEND_API_KEY=re_...
FROM_EMAIL=bookings@punicodex.com
REPLY_TO_EMAIL=support@punicodex.com
ADMIN_EMAIL=admin@punicodex.com

# AI / Oracle
ORACLE_LLM_API_KEY=
ORACLE_LLM_MODEL=

# Analytics & search console
GA_MEASUREMENT_ID=
GSC_VERIFICATION=

# Data licensing
PUNICODEX_LICENSE=
PUNICODEX_LICENSE_URL=

# GitHub integration
GITHUB_TOKEN=
