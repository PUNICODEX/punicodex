# PUNICODEX environment template
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to Git.

# Admin & security
ADMIN_PASSWORD=change-me-in-production
CRON_SECRET=generate-a-long-random-secret

# Platform URL
PLATFORM_URL=http://localhost:3456

# Database
DATABASE_URL=
REDIS_URL=

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
RESEND_API_KEY=re_...
FROM_EMAIL=bookings@punicodex.com
REPLY_TO_EMAIL=support@punicodex.com
ADMIN_EMAIL=admin@punicodex.com

# AI / Oracle
ORACLE_LLM_API_KEY=
ORACLE_LLM_MODEL=
# Optional: set ORACLE_LLM_PROVIDER=nemotron to switch the Oracle to NVIDIA
# Nemotron (NIM cloud endpoint by default; point NEMOTRON_BASE_URL at a local
# vLLM to self-host). NEMOTRON_MODEL defaults to llama-3.3-nemotron-super-49b-v1.5.
# ORACLE_LLM_PROVIDER=
# NEMOTRON_API_KEY=
# NEMOTRON_MODEL=
# NEMOTRON_BASE_URL=

# Analytics & search console
GA_MEASUREMENT_ID=
GSC_VERIFICATION=

# Data licensing
PUNICODEX_LICENSE=
PUNICODEX_LICENSE_URL=

# GitHub integration
GITHUB_TOKEN=
