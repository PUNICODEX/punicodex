<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/palette_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#080808"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PuniCodex Directory"
            android:textColor="#D4AF37"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/palette_multi_select_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/palette_chip_bg"
            android:text="Multi-select"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/palette_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1a1a1a"
        android:hint="Search symbols…"
        android:textColorHint="#666666"
        android:textColor="#e0e0e0"
        android:textSize="16sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="textNoSuggestions"
        android:importantForAutofill="no" />

    <HorizontalScrollView
        android:id="@+id/palette_category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/palette_category_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/palette_grid_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:scrollbars="vertical">

        <GridLayout
            android:id="@+id/palette_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:useDefaultMargins="false" />
    </ScrollView>

    <TextView
        android:id="@+id/palette_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="No symbols found"
        android:textColor="#666666"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/palette_buffer_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/palette_buffer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compose sequence"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/palette_buffer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D4AF37"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="32dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/palette_buffer_copy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/accent_key_bg"
                android:text="Copy all"
                android:textColor="#D4AF37"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/palette_buffer_insert"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/accent_key_bg"
                android:text="Insert"
                android:textColor="#D4AF37"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/palette_buffer_clear"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/accent_key_bg"
                android:text="Clear"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
