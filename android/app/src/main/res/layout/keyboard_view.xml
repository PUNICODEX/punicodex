<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#080808"
    android:paddingStart="@dimen/keyboard_padding_h"
    android:paddingEnd="@dimen/keyboard_padding_h"
    android:paddingTop="@dimen/keyboard_padding_top"
    android:paddingBottom="@dimen/keyboard_padding_bottom">

    <!-- Main keyboard content -->
    <LinearLayout
        android:id="@+id/keyboard_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Suggestion Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/suggestion_row_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/typed_word"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLength="22"
                android:ellipsize="end"
                android:maxLines="1" />

            <HorizontalScrollView
                android:id="@+id/suggestion_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/suggestion_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#151515"
            android:layout_marginBottom="4dp" />

        <!-- QWERTY Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/row_gap">

            <Button android:id="@+id/key_q" style="@style/KeyButton" android:text="q" />
            <Button android:id="@+id/key_w" style="@style/KeyButton" android:text="w" />
            <Button android:id="@+id/key_e" style="@style/KeyButton" android:text="e" />
            <Button android:id="@+id/key_r" style="@style/KeyButton" android:text="r" />
            <Button android:id="@+id/key_t" style="@style/KeyButton" android:text="t" />
            <Button android:id="@+id/key_y" style="@style/KeyButton" android:text="y" />
            <Button android:id="@+id/key_u" style="@style/KeyButton" android:text="u" />
            <Button android:id="@+id/key_i" style="@style/KeyButton" android:text="i" />
            <Button android:id="@+id/key_o" style="@style/KeyButton" android:text="o" />
            <Button android:id="@+id/key_p" style="@style/KeyButton" android:text="p" />
        </LinearLayout>

        <!-- QWERTY Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="@dimen/row_gap">

            <Button android:id="@+id/key_a" style="@style/KeyButton" android:text="a" />
            <Button android:id="@+id/key_s" style="@style/KeyButton" android:text="s" />
            <Button android:id="@+id/key_d" style="@style/KeyButton" android:text="d" />
            <Button android:id="@+id/key_f" style="@style/KeyButton" android:text="f" />
            <Button android:id="@+id/key_g" style="@style/KeyButton" android:text="g" />
            <Button android:id="@+id/key_h" style="@style/KeyButton" android:text="h" />
            <Button android:id="@+id/key_j" style="@style/KeyButton" android:text="j" />
            <Button android:id="@+id/key_k" style="@style/KeyButton" android:text="k" />
            <Button android:id="@+id/key_l" style="@style/KeyButton" android:text="l" />
        </LinearLayout>

        <!-- QWERTY Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/row_gap">

            <Button android:id="@+id/key_shift" style="@style/KeyButtonWide" android:text="⇧" />
            <Button android:id="@+id/key_z" style="@style/KeyButton" android:text="z" />
            <Button android:id="@+id/key_x" style="@style/KeyButton" android:text="x" />
            <Button android:id="@+id/key_c" style="@style/KeyButton" android:text="c" />
            <Button android:id="@+id/key_v" style="@style/KeyButton" android:text="v" />
            <Button android:id="@+id/key_b" style="@style/KeyButton" android:text="b" />
            <Button android:id="@+id/key_n" style="@style/KeyButton" android:text="n" />
            <Button android:id="@+id/key_m" style="@style/KeyButton" android:text="m" />
            <Button android:id="@+id/key_backspace" style="@style/KeyButtonWide" android:text="⌫" />
        </LinearLayout>

        <!-- Bottom Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:gravity="center">

            <Button android:id="@+id/key_symbols" style="@style/KeyButtonWide" android:text="123" />
            <Button android:id="@+id/key_puni" style="@style/KeyButtonPuni" android:text="Ω" />
            <Button android:id="@+id/key_comma" style="@style/KeyButtonPunct" android:text="," />
            <Button android:id="@+id/key_space" style="@style/KeyButtonSpace" android:text="" />
            <Button android:id="@+id/key_period" style="@style/KeyButtonPunct" android:text="." />
            <Button android:id="@+id/key_question" style="@style/KeyButtonPunct" android:text="?" />
            <Button android:id="@+id/key_return" style="@style/KeyButtonWide" android:text="↵" />
        </LinearLayout>

        <!-- System bar avoidance spacer -->
        <View
            android:id="@+id/bottom_spacer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/system_bar_spacer"
            android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
