<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- Letter Keys -->
    <style name="KeyButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#e0e0e0</item>
        <item name="android:textSize">@dimen/key_text_size</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:layout_margin">@dimen/key_margin</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Special Keys (Shift, Backspace, Return, Symbols) -->
    <style name="KeyButtonWide" parent="KeyButton">
        <item name="android:layout_weight">1.4</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#cccccc</item>
        <item name="android:background">@drawable/key_special_bg</item>
    </style>

    <!-- Space Bar -->
    <style name="KeyButtonSpace" parent="KeyButton">
        <item name="android:layout_weight">4.5</item>
        <item name="android:background">@drawable/key_special_bg</item>
    </style>

    <!-- Punctuation Keys (comma, period) -->
    <style name="KeyButtonPunct" parent="KeyButton">
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#cccccc</item>
        <item name="android:background">@drawable/key_special_bg</item>
    </style>
</resources>
