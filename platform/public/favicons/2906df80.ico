        <div class="max_wymiar">        
            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 do_srodka">      
				<div class="cz_30 cz_bold cz_upper">Contact Us</div>
                <div class="odstep_30"></div>
                Feel free to contact us <a href="tel:+447588060806" class="cz_30 nie_dziel">+44 75 88 06 08 06</a> or write to us 
                <a href="mailto:info@veles.uk" class="cz_30">info@veles.uk</a>
                <div class="odstep_30"></div>
                Call or write to us and we will answer all your questions
                <div class="odstep_50"></div>
                
   					<form action="contact" id="kontakt" name="kontakt" onsubmit="return sprawdz_formularz()" method="post" enctype="multipart/form-data" >
                    	<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                            <input name="imie" type="text" class="form_rej_txt_k" placeholder="&#10148; Name:" />
                            <div class="odstep_20"></div>
                            <input name="nazwisko" type="text" class="form_rej_txt_k" placeholder="&#10148; Surname:" />
                            <div class="odstep_20"></div>                                                    
                        </div>
                    	<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                            <input name="telefon" type="text" class="form_rej_txt_k" placeholder="&#10148; Phone:" /> 
                            <div class="odstep_20"></div>
                            <input name="email" type="text" class="form_rej_txt_k" placeholder="&#10148; Email:" />
                            <div class="odstep_20"></div>                        
                        </div>
                    	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        	<textarea name="wiadomosc" class="form_rej_text_k" placeholder="&#10148; Message:"></textarea>
                            <div class="odstep_20"></div> 
                        </div>
                        <input name="wyslij" type="hidden" value="1" />
                        <input name="krotka" type="hidden" value="1780658232" />
                        <input name="" type="submit" value="Send a message" class="form_rej_submit" />
                    </form>
                    <div class="odstep_25"></div>
                    
				<script type="text/javascript">
				var regex = /^[a-zA-Z0-9._-]+@([a-zA-Z0-9.-]+.)+[a-zA-Z0-9.-]{2,4}$/; 
                function sprawdz_formularz()
                {
                    // przypisanie obiektu formularza do zmiennej
                    var f = document.forms['kontakt'];
                    // sprawdzenie imienia
                    if (f.imie.value == '')
                    {
                        alert('You must enter your name');
                        f.imie.focus();
                        return false;
                    }				
                    if ((regex.test(f.email.value)==false) || (f.email.value=='')) 
                    {
                        alert('You must enter your email address');
                        f.email.focus();
                        return false;
                    }
                    if (f.wiadomosc.value == '')
                    {
                        alert('You must enter your message');
                        f.wiadomosc.focus();
                        return false;
                    }					
                    // formularz jest wypelniony poprawnie
                    return true;
                }
                      </script>                  
                
