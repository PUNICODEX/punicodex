	var cookie = Cookies.get('invoice_popup');
	if(cookie){
		$('.invoice_popup').addClass('close');
	}
	$('.js-popup_btn').on('click',function(){
		Cookies.set('invoice_popup','close', { expires: 1 });
		$("#popup_wrap").fadeOut(900);
	});
