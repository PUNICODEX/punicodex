<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Premium UK Domain Names for Sale | DomainStore</title>
<meta name="description" content="Browse and buy premium .UK domain names from DomainStore. Over 25 years of experience, 1,600+ domains sold, Nominet-accredited registrar. Secure escrow available." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --blue: #1a7cc4;
  --blue-dark: #145f96;
  --blue-light: #e8f3fb;
  --text: #1a1f2e;
  --text-muted: #6b7280;
  --border: #e2e8f0;
  --bg: #f8fafc;
  --white: #fff;
  --radius: 10px;
  --radius-sm: 6px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 20px rgba(0,0,0,.10);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--blue); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── HEADER ── */
.site-header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  overflow: visible;
}
.header-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 24px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo img { height: 44px; display: block; }
.site-nav { display: flex; align-items: center; gap: 6px; }
.site-nav a {
  color: var(--text-muted);
  font-size: 13px;
  padding: 6px 10px;
  border-radius: var(--radius-sm);
  transition: color .15s, background .15s;
}
.site-nav a:hover { color: var(--blue); background: var(--blue-light); text-decoration: none; }
.site-nav a.active { color: var(--blue); font-weight: 500; }
.nav-sep { color: var(--border); font-size: 13px; }

/* ── HERO ── */
.hero {
  background:
    radial-gradient(900px 400px at 50% 0%, rgba(26,124,196,.16) 0%, rgba(26,124,196,.05) 50%, transparent 72%),
    linear-gradient(180deg, #edf5fc 0%, var(--bg) 100%);
  border-bottom: 1px solid var(--border);
  padding: 56px 24px 44px;
  text-align: center;
}
.hero-inner { max-width: 680px; margin: 0 auto; }

.hero h1 {
  font-family: 'Nunito', sans-serif;
  font-size: clamp(34px, 4.8vw, 56px);
  font-weight: 900;
  color: var(--text);
  letter-spacing: -1.5px;
  line-height: 1.06;
  margin-bottom: 12px;
}
.hero h1 span { color: var(--blue); }
.hero .subtitle {
  font-size: 16px;
  color: var(--text-muted);
  margin-bottom: 30px;
  max-width: 50ch;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}
.hero .subtitle strong { color: var(--text); font-weight: 600; }

/* Trust grid */
.trust-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  max-width: 580px;
  margin: 0 auto 28px;
  text-align: left;
}
.trust-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  box-shadow: var(--shadow-sm);
}
.trust-item .emoji { font-size: 16px; flex-shrink: 0; margin-top: 2px; }
.trust-item span { font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.4; }

/* ── STATS ── */
.stats-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}
.stat {
  display: flex;
  align-items: baseline;
  gap: 6px;
  font-size: 13px;
  color: var(--text-muted);
}
.stat strong {
  font-family: 'Nunito', sans-serif;
  font-size: 22px;
  font-weight: 900;
  color: var(--text);
  letter-spacing: -.5px;
}
.stat-sep { color: var(--border); font-size: 20px; }

/* ── PAGE WRAP ── */
.page {
  max-width: 980px;
  margin: 0 auto;
  padding: 28px 24px 64px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ── CARD ── */
.card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.card-head {
  background: var(--blue);
  padding: 11px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-head h2 {
  font-family: 'Nunito', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  letter-spacing: .2px;
}
.card-head a {
  font-size: 12px;
  color: rgba(255,255,255,.8);
  font-weight: 500;
}
.card-head a:hover { color: #fff; text-decoration: none; }
.card-body { padding: 18px; }

/* ── FEATURED DOMAINS ── */
.domains-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.domain-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg);
  transition: border-color .15s, box-shadow .15s, transform .15s;
}
.domain-row:hover {
  border-color: var(--blue);
  box-shadow: 0 4px 16px rgba(26,124,196,.12);
  transform: translateY(-2px);
}
.domain-name {
  font-family: 'Nunito', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -.3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  flex: 1;
}
.btn-enquire {
  display: inline-block;
  background: var(--blue);
  color: #fff;
  border-radius: var(--radius-sm);
  padding: 7px 14px;
  font-size: 12px;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  transition: background .15s;
  flex-shrink: 0;
  white-space: nowrap;
}
.btn-enquire:hover { background: var(--blue-dark); text-decoration: none; color: #fff; }

/* ── WHY CHOOSE ── */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.feature-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px;
  background: var(--bg);
}
.feature-card-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.feature-icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-sm);
  background: var(--blue-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.feature-icon svg { width: 17px; height: 17px; stroke: var(--blue); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.feature-card h3 { font-family: 'Nunito', sans-serif; font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.3; }
.feature-card p { font-size: 13px; color: var(--text-muted); line-height: 1.65; }

/* ── FOOTER ── */
.site-footer {
  background: var(--white);
  border-top: 1px solid var(--border);
  margin-top: 20px;
  padding: 20px 0;
}
.footer-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 24px;
}
.footer-bottom {
  border-top: 1px solid var(--border);
  padding-top: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-muted);
}
.footer-logo img { height: 28px; opacity: .7; }

/* ── HERO SEARCH ── */
.hero-search {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 8px 0 16px;
  border-radius: 50px;
  background: var(--white);
  border: 1.5px solid var(--border);
  box-shadow: var(--shadow-sm);
  transition: border-color .15s, box-shadow .15s;
  position: relative;
}
.hero-search:focus-within {
  border-color: var(--blue);
  box-shadow: 0 4px 24px rgba(26,124,196,.12);
}
.hero-search svg { color: var(--text-muted); flex-shrink: 0; }
.hero-search input {
  flex: 1;
  border: none;
  background: none;
  outline: none;
  padding: 14px 0;
  font-size: 15px;
  color: var(--text);
  font-family: inherit;
}
.hero-search input::placeholder { color: var(--text-muted); }
.hero-search-btn {
  background: var(--blue);
  color: #fff;
  border: none;
  border-radius: 50px;
  padding: 9px 20px;
  font-size: 13px;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  cursor: pointer;
  flex-shrink: 0;
  transition: background .15s;
}
.hero-search-btn:hover { background: var(--blue-dark); }

/* ── SEARCH RESULTS ── */
.search-results {
  display: none;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 8px 32px rgba(0,0,0,.10);
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  z-index: 50;
  overflow: hidden;
}
.search-results.visible { display: block; }
.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 16px;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  text-decoration: none;
  transition: background .12s;
}
.search-result-item:last-child { border-bottom: 0; }
.search-result-item:hover { background: var(--blue-light); color: var(--blue); text-decoration: none; }
.search-result-item svg { color: var(--text-muted); flex-shrink: 0; }
.search-no-results {
  padding: 14px 16px;
  font-size: 13px;
  color: var(--text-muted);
  text-align: center;
}
.search-more {
  display: block;
  text-align: center;
  padding: 10px;
  font-size: 12px;
  color: var(--blue);
  border-top: 1px solid var(--border);
  text-decoration: none;
  font-weight: 600;
}
.search-more:hover { background: var(--blue-light); text-decoration: none; }

/* ── BROWSE BUTTONS ── */
.browse-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
}
.btn-browse {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 10px 22px;
  font-size: 14px;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  color: var(--text);
  background: var(--white);
  text-decoration: none;
  transition: border-color .15s, box-shadow .15s, transform .15s;
}
.btn-browse:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(26,124,196,.12); text-decoration: none; }
.btn-browse.btn-premium {
  background: var(--blue);
  color: #fff;
  border-color: var(--blue);
}
.btn-browse.btn-premium:hover { background: var(--blue-dark); border-color: var(--blue-dark); color: #fff; }

/* ── FOOTER CATEGORIES ── */
.footer-categories {
  padding-bottom: 18px;
  margin-bottom: 18px;
  border-bottom: 1px solid var(--border);
}
.footer-categories h3 {
  font-family: 'Nunito', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: 12px;
}
.categories-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 4px 10px;
}
.categories-grid a {
  font-size: 12px;
  color: var(--text-muted);
  text-decoration: none;
  padding: 3px 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color .12s;
}
.categories-grid a:hover { color: var(--blue); text-decoration: none; }

@media (max-width: 860px) {
  .domains-grid { grid-template-columns: 1fr 1fr; }
  .features-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 680px) {
  .categories-grid { grid-template-columns: repeat(2, 1fr); }
  .browse-actions { flex-direction: column; align-items: center; }
}
@media (max-width: 680px) {
  .site-nav { display: none; }
  .trust-grid { grid-template-columns: 1fr; }
  .domains-grid { grid-template-columns: 1fr 1fr; }
  .features-grid { grid-template-columns: 1fr; }
  .hero { padding: 40px 20px 32px; }
}
@media (max-width: 500px) {
  .domains-grid { grid-template-columns: 1fr; }
}

/* ── HAMBURGER MENU ── */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 36px;
  height: 36px;
  background: none;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  padding: 6px;
  flex-shrink: 0;
}
.hamburger span {
  display: block;
  height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: transform .2s, opacity .2s;
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
.mobile-nav {
  display: none;
  position: fixed;
  top: 64px;
  left: 0;
  right: 0;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 4px 16px rgba(0,0,0,.10);
  z-index: 200;
  flex-direction: column;
}
.mobile-nav.open { display: flex; }
.mobile-nav a {
  display: block;
  padding: 13px 24px;
  font-size: 15px;
  color: var(--text-muted);
  font-weight: 500;
  border-bottom: 1px solid var(--border);
  text-decoration: none;
  transition: background .15s, color .15s;
}
.mobile-nav a:last-child { border-bottom: 0; }
.mobile-nav a:hover { background: var(--blue-light); color: var(--blue); }
.mobile-nav a.active { color: var(--blue); background: var(--blue-light); }
@media (max-width: 680px) {
  .site-nav { display: none !important; }
  .hamburger { display: flex; }
}
</style>
