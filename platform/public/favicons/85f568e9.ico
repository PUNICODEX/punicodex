<script>
function toggleMobileNav() {
  var btn = document.getElementById('hamburgerBtn');
  var menu = document.getElementById('mobileNav');
  if (!btn || !menu) return;
  btn.classList.toggle('open');
  menu.classList.toggle('open');
}
</script>


<script>
// ── Mobile nav ──
function toggleMobileNav() {
  var btn = document.getElementById('hamburgerBtn');
  var menu = document.getElementById('mobileNav');
  if (!btn || !menu) return;
  btn.classList.toggle('open');
  menu.classList.toggle('open');
}

// ── Search ──
var searchTimer = null;

document.getElementById('heroSearch').addEventListener('input', function() {
  clearTimeout(searchTimer);
  var q = this.value.trim();
  if (q.length < 3) {
    hideResults();
    return;
  }
  searchTimer = setTimeout(function() { runSearch(q); }, 280);
});

document.getElementById('heroSearch').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
});

function doSearch() {
  var q = document.getElementById('heroSearch').value.trim();
  if (q.length < 3) return;
  window.location.href = 'domains.php?q=' + encodeURIComponent(q);
}

function runSearch(q) {
  var box = document.getElementById('searchResults');
  box.innerHTML = '<div class="search-no-results">Searching…</div>';
  box.classList.add('visible');

  fetch('search.php?q=' + encodeURIComponent(q) + '&status=active&limit=5')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.results || data.results.length === 0) {
        box.innerHTML = '<div class="search-no-results">No domains found matching <strong>' + escHtml(q) + '</strong></div>';
        return;
      }
      var html = '';
      data.results.forEach(function(d) {
        html += '<a class="search-result-item" href="forsale.php?domain=' + encodeURIComponent(d.domain) + '">'
          + '<span>' + escHtml(d.domain) + '</span>'
          + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>'
          + '</a>';
      });
      if (data.total > 5) {
        html += '<a class="search-more" href="domains.php?q=' + encodeURIComponent(q) + '">View all ' + data.total + ' results →</a>';
      }
      box.innerHTML = html;
    })
    .catch(function() {
      box.innerHTML = '<div class="search-no-results">Search unavailable.</div>';
    });
}

function hideResults() {
  var box = document.getElementById('searchResults');
  box.classList.remove('visible');
  box.innerHTML = '';
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// Close results when clicking outside
document.addEventListener('click', function(e) {
  if (!e.target.closest('.hero-search') && !e.target.closest('#searchResults')) {
    hideResults();
  }
});
</script>
</body>
</html>
