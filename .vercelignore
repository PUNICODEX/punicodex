.git
.gitignore
node_modules
.venv_hieropy
.vercel
.kimi
**/.backup
*.log
*.zip
*.tar.gz
*.rar
.DS_Store
Thumbs.db
desktop.ini
.vscode
*.swp
*.swo
*~
dist
build

# Dev / build-only directories (not needed in the production deployment)
# NOTE: anchored to the ROOT dirs only — unanchored names would also exclude
# runtime paths such as platform/scripts/ and api/v1/docs/.
/docs/
/test/
/scripts/
data/corpus/
data/authoritative/
data/benchmarks/
branding/
extended flagship materials/
android/
extension/
extension-v2/

# Database artifacts and large generated corpora not served at runtime
platform/db/*.backup
platform/db/*.db-journal
platform/db/*.db-wal
platform/db/*.db-shm
*.db.backup

# Image deployment optimization:
# Every temple ships WebP as the primary <picture> source. PNG fallbacks are
# kept in the repo for older browsers / structured data, but uploading both
# formats pushes the deployment well over Vercel's CLI buffer limit.
# Modern browsers (96%+ market share) support WebP, so we deploy WebP only.
sites/**/*.png
