{
  "brand": "PuniCodex",
  "version": "1.0",
  "year": 2026,
  "color": {
    "obsidian":       "#0A0A0C",
    "templeBlack":    "#121216",
    "templeRaise":    "#1A1A20",
    "gold":           "#D4AF37",
    "goldHighlight":  "#F5E3A8",
    "goldMid":        "#C9A23F",
    "goldDeep":       "#8C6A22",
    "ivory":          "#F4EFE4",
    "ash":            "#9A968C",
    "ashDim":         "#6B685F",
    "line":           "rgba(212,175,55,0.22)",
    "lineStrong":     "rgba(212,175,55,0.45)",
    "goldGhost":      "rgba(212,175,55,0.08)"
  },
  "gradient": {
    "goldMetal": ["#F5E3A8", "#C9A23F", "#8C6A22"],
    "goldMetalStops": [0, 0.45, 1]
  },
  "font": {
    "display": { "family": "Cinzel", "fallback": "serif", "usage": "wordmark, hero caps, tier numerals", "weights": [400, 700, 900] },
    "serif":   { "family": "Cormorant Garamond", "fallback": "Georgia, serif", "usage": "editorial, kickers, taglines", "weights": [300, 700] },
    "sans":    { "family": "Inter", "fallback": "system-ui, sans-serif", "usage": "UI body, buttons, meta", "weights": [400, 700] }
  },
  "tracking": { "kicker": "0.42em", "displayCaps": "0.16em", "wordmark": "0.16em" },
  "radius": { "card": "6px", "pill": "999px" },
  "shadow": {
    "card": "0 18px 50px rgba(0,0,0,0.55)",
    "gold": "0 6px 30px rgba(212,175,55,0.18)"
  },
  "layout": { "maxWidth": "1280px", "sectionY": "clamp(4rem,10vw,8rem)" }
}
