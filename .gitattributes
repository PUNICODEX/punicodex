# Force LF line endings for all text files to keep CI divergence gate stable on Windows.
* text=auto eol=lf

# Treat generated assets and binaries as non-text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.db binary
*.zip binary
